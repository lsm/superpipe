{
  "name": "superpipe",
  "version": "0.15.0",
  "description": "The missing pipeline for functional programming",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "es/**/*",
    "lib/**/*",
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "es/package.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint:pkg": "publint && attw --pack . --ignore-rules missing-export-equals",
    "typecheck": "tsc --noEmit",
    "build:es": "cross-env NODE_ENV=production tsc -d --noEmit false --module es6 --outDir ./es && node ./scripts/rename-es-mjs.mjs",
    "build:cjs": "cross-env NODE_ENV=production babel -x '.ts' -d ./lib src",
    "build:umd": "cross-env NODE_ENV=development rollup -c -o dist/superpipe.js",
    "build:umd:min": "cross-env NODE_ENV=production rollup -c -o dist/superpipe.min.js",
    "build:types": "tsc -d --emitDeclarationOnly --noEmit false --outDir ./lib",
    "build": "npm run build:es && npm run build:cjs && npm run build:types && npm run build:umd && npm run build:umd:min"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-add-module-exports": "1.0.4",
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-import": "2.32.0",
    "publint": "0.3.23",
    "rollup": "4.62.4",
    "source-map-support": "0.5.21",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsm/superpipe.git"
  },
  "keywords": [
    "flow",
    "stream",
    "pipe",
    "pipeline",
    "event",
    "ioc",
    "frp",
    "functional",
    "reactive",
    "monad"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "lsm <marc@liu.pm> (https://github.com/lsm)",
  "license": "MIT",
  "browserslist": {
    "development": [
      "last 1 chrome versions",
      "last 1 firefox versions",
      "last 1 safari version"
    ],
    "production": [
      "> 0.25%",
      "not dead"
    ]
  }
}
