{
  "name": "superpipe",
  "version": "0.17.0",
  "description": "The missing pipeline for functional programming",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint:pkg": "publint && attw --pack . --ignore-rules missing-export-equals",
    "typecheck": "tsc --noEmit",
    "build": "tsdown && tsdown --config tsdown.iife.config.mts",
    "bench": "npm run build && node bench/perf.mjs && node bench/async.mjs && node --expose-gc bench/mem.mjs",
    "lint": "biome check src test",
    "check:no-comments": "node scripts/strip-comments.mjs --check",
    "lint:fix": "biome check src test --write",
    "format": "biome format src test --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.8",
    "@vitest/coverage-v8": "4.1.10",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "unrun": "0.3.1",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsm/superpipe.git"
  },
  "keywords": [
    "flow",
    "stream",
    "pipe",
    "pipeline",
    "event",
    "ioc",
    "frp",
    "functional",
    "reactive",
    "monad"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "lsm <marc@liu.pm> (https://github.com/lsm)",
  "license": "MIT",
  "browserslist": {
    "development": [
      "last 1 chrome versions",
      "last 1 firefox versions",
      "last 1 safari version"
    ],
    "production": [
      "> 0.25%",
      "not dead"
    ]
  }
}
