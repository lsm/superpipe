{
  "name": "superpipe",
  "version": "0.15.0",
  "description": "The missing pipeline for functional programming",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "es/**/*",
    "lib/**/*",
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "cross-env NODE_ENV=development mocha --recursive --require source-map-support --require ./babel-register",
    "watch": "nodemon -w ./src -w ./test -x 'npm run test'",
    "coverage": "cross-env NODE_ENV=test nyc mocha --recursive",
    "report-coverage": "nyc report --reporter=text-lcov | coveralls",
    "typecheck": "tsc --noEmit",
    "build:es": "cross-env NODE_ENV=production tsc -d --noEmit false --module es6 --outDir ./es",
    "build:cjs": "cross-env NODE_ENV=production babel -x '.ts' -d ./lib src",
    "build:umd": "cross-env NODE_ENV=development rollup -c -o dist/superpipe.js",
    "build:umd:min": "cross-env NODE_ENV=production rollup -c -o dist/superpipe.min.js",
    "build:types": "tsc -d --emitDeclarationOnly --noEmit false --outDir ./lib",
    "build": "npm run build:es && npm run build:cjs && npm run build:types && npm run build:umd && npm run build:umd:min"
  },
  "nyc": {
    "require": [
      "./babel-register"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "lcov",
      "html",
      "text"
    ],
    "sourceMap": false,
    "instrument": false
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/register": "7.29.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "babel-plugin-istanbul": "8.0.0",
    "chai": "4.5.0",
    "coveralls": "3.1.1",
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-import": "2.32.0",
    "mocha": "11.8.0",
    "mocha-lcov-reporter": "1.3.0",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "rollup": "4.62.4",
    "source-map-support": "0.5.21",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/lsm/superpipe.git"
  },
  "keywords": [
    "flow",
    "stream",
    "pipe",
    "pipeline",
    "event",
    "ioc",
    "frp",
    "functional",
    "reactive",
    "monad"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "lsm <marc@liu.pm> (https://github.com/lsm)",
  "license": "MIT",
  "browserslist": {
    "development": [
      "last 1 chrome versions",
      "last 1 firefox versions",
      "last 1 safari version"
    ],
    "production": [
      "> 0.25%",
      "not dead"
    ]
  }
}
