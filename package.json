{
  "name": "superpipe",
  "version": "0.14.0",
  "description": "The missing pipeline for functional programming",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "types/index.d.ts",
  "files": [
    "es",
    "lib",
    "src",
    "dist",
    "types",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "mocha --require ./babel-register.js",
    "watch": "nodemon -w ./src -w ./test -x 'npm run coverage'",
    "browser": "TEST_ENV=browser karma start karma.conf.js",
    "local-browser": "karma start karma.conf.js",
    "coverage": "nyc npm test",
    "report-coverage": "nyc report --reporter=text-lcov | coveralls",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir es --extensions '.ts'",
    "build:cjs": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --extensions '.ts'",
    "build:umd": "cross-env BABEL_ENV=rollup NODE_ENV=development rollup -c rollup.config.mjs -o dist/alfa.js",
    "build:umd:min": "cross-env BABEL_ENV=rollup NODE_ENV=production rollup -c rollup.config.mjs -o dist/alfa.min.js",
    "build": "npm run build:types && npm run build:es && npm run build:cjs && npm run build:umd && npm run build:umd:min"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "reporter": [
      "lcov",
      "html",
      "text"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@babel/register": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "ajv": "6.5.2",
    "assume": "2.1.0",
    "chai": "4.1.2",
    "coveralls": "3.0.2",
    "cross-env": "5.2.0",
    "eslint": "5.3.0",
    "eslint-config-airbnb-base": "13.1.0",
    "eslint-plugin-import": "2.14.0",
    "karma": "3.0.0",
    "karma-chrome-launcher": "2.2.0",
    "karma-mocha": "1.3.0",
    "karma-sauce-launcher": "git+https://github.com/lsm/karma-sauce-launcher.git#1.2.1",
    "karma-webpack": "3.0.0",
    "mocha": "5.2.0",
    "mocha-lcov-reporter": "1.3.0",
    "nodemon": "1.18.3",
    "nyc": "12.0.2",
    "prettier": "1.14.2",
    "rollup": "^4.9.0",
    "sauce-connect-launcher": "1.2.4",
    "typescript": "^5.3.0",
    "webpack": "4.16.5"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/lsm/superpipe.git"
  },
  "keywords": [
    "flow",
    "stream",
    "pipe",
    "pipeline",
    "event",
    "ioc",
    "frp",
    "functional",
    "reactive",
    "monad"
  ],
  "engines": {
    "node": ">= 12.0.0"
  },
  "author": "lsm <marc@liu.pm> (https://github.com/lsm)",
  "license": "MIT"
}
