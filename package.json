{
  "name": "superpipe",
  "version": "0.15.0",
  "description": "The missing pipeline for functional programming",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint:pkg": "publint && attw --pack .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown && tsdown --config tsdown.iife.config.mts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "8.57.1",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-import": "2.32.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsm/superpipe.git"
  },
  "keywords": [
    "flow",
    "stream",
    "pipe",
    "pipeline",
    "event",
    "ioc",
    "frp",
    "functional",
    "reactive",
    "monad"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "lsm <marc@liu.pm> (https://github.com/lsm)",
  "license": "MIT",
  "browserslist": {
    "development": [
      "last 1 chrome versions",
      "last 1 firefox versions",
      "last 1 safari version"
    ],
    "production": [
      "> 0.25%",
      "not dead"
    ]
  }
}
