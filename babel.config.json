{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "browsers": [
          "last 1 version",
          "> 1%",
          "not dead"
        ],
        "node": "12"
      }
    }],
    "@babel/preset-typescript"
  ],
  "env": {
    "development": {
      "sourceMaps": "inline"
    },
    "es": {
      "presets": [
        ["@babel/preset-env", {
          "modules": false,
          "targets": {
            "browsers": [
              "last 1 version",
              "> 1%",
              "not dead"
            ]
          }
        }],
        "@babel/preset-typescript"
      ]
    },
    "commonjs": {
      "presets": [
        ["@babel/preset-env", {
          "modules": "commonjs",
          "targets": {
            "node": "12"
          }
        }],
        "@babel/preset-typescript"
      ]
    },
    "rollup": {
      "presets": [
        ["@babel/preset-env", {
          "modules": false,
          "targets": {
            "browsers": [
              "last 1 version",
              "> 1%",
              "not dead"
            ]
          }
        }],
        "@babel/preset-typescript"
      ]
    }
  }
}
